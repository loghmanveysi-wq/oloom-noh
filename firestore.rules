// قوانین امنیتی Firestore
// این کد را در Firebase Console > Firestore Database > Rules قرار دهید

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // هر کاربر فقط داده خودش را می‌بیند؛ دبیر (مدیر) به همه دسترسی خواندن دارد.
    // نقش (role) را کاربر نمی‌تواند عوض کند: ثبت‌نام فقط student می‌سازد و
    // نقش teacher فقط دستی از Firebase Console روی حساب مدیر گذاشته می‌شود.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTeacher());
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == 'student'
        && request.resource.data.xp == 0
        && request.resource.data.level == 1;
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /{subcollection=**} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isTeacher());
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // نگاشت «شماره موبایل ← ایمیل» برای ورود با شماره موبایل.
    // فقط get مجاز است (list ممنوع)، چون قبل از ورود باید خوانده شود.
    // ساخت سند فقط توسط خود صاحب حساب و فقط با ایمیل خودش ممکن است.
    match /loginIndex/{phone} {
      allow get: if phone.matches('^09[0-9]{9}$');
      allow list: if false;
      allow create: if isSignedIn()
        && phone.matches('^09[0-9]{9}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------- رقابت زنده ----------------
    // صف جستجوی حریف: هر کاربر ورودی خودش را می‌سازد؛ کاربر دیگر فقط می‌تواند
    // فیلد matchId را (هم‌زمان با ساخت یک بازی که هر دو نفر در آن هستند) پر کند.
    match /matchQueue/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.matchId == null;
      allow update: if isSignedIn() && (
        request.auth.uid == uid
        || (resource.data.matchId == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matchId'])
            && request.resource.data.matchId is string
            && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.players.hasAll([uid, request.auth.uid]))
      );
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // بازی رقابتی: فقط دو بازیکن آن را می‌بینند و تغییر می‌دهند؛ بازیکنان، سؤال‌ها و اطلاعات نمایشی قابل تغییر نیستند.
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.players;
      allow create: if isSignedIn()
        && request.resource.data.players.size() == 2
        && request.auth.uid in request.resource.data.players
        && request.resource.data.status == 'active';
      allow update: if isSignedIn() && request.auth.uid in resource.data.players
        && request.resource.data.players == resource.data.players
        && request.resource.data.questions == resource.data.questions
        && request.resource.data.info == resource.data.info;
      allow delete: if false;
    }

    // خلاصه فصل، جواب فعالیت‌ها و خودآزمایی‌ها: خواندن برای کاربران واردشده، نوشتن فقط مدیر
    match /chapterContent/{chapterId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();

      match /{sub}/{docId} {
        allow read: if isSignedIn();
        allow write: if isTeacher();
      }
    }

    // پروفایل استاد: خواندن برای همه، نوشتن فقط خود دبیر
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // کتاب‌ها و تصاویر: خواندن برای همه کاربران وارد شده، نوشتن فقط دبیر
    match /books/{bookId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    match /images/{chapterId}/{document=**} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    match /quizzes/{document=**} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    match /reports/{document=**} {
      allow read: if isTeacher();
      allow write: if isTeacher();
    }
  }
}

// Firebase Storage استفاده نمی‌شود (آپلود فایل‌ها با Cloudinary است). آن را فعال نکنید.
